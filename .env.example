# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://cccron_app:password@host:5432/cccron?sslmode=verify-full
DB_SCHEMA=user_chess_analysis
TARGET_USER_ID=1
# Optional: connect by IP while keeping the URL host for TLS SNI (split DNS).
# DB_HOSTADDR=

# --- Engine backend ---------------------------------------------------------
# "local" drives a local Stockfish UCI binary; "remote" calls engine_server.
ENGINE_MODE=local
# Used when ENGINE_MODE=local. A command name resolves through PATH; an
# absolute path is recommended for cron and services.
STOCKFISH_PATH=stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128
# Used when ENGINE_MODE=remote (see engine_server/):
ENGINE_API_URL=http://127.0.0.1:8000
ENGINE_API_KEY=your-engine-server-key
ENGINE_TIMEOUT_SEC=1200

# --- Analysis (analyze stage) ----------------------------------------------
# Fast first pass over every position.
ANALYSIS_DEPTH=16
ANALYSIS_MULTIPV=1
# Selectively revisit the largest swings and tactical positions.
ANALYSIS_DEEP_DEPTH=20
ANALYSIS_DEEP_MULTIPV=3
ANALYSIS_DEEP_THRESHOLD_CP=60
ANALYSIS_DEEP_MAX_MOVES=12

# --- Puzzle cooking (generate stage) ---------------------------------------
COOK_DEPTH=19
COOK_TIME_SEC=3
PUZZLE_MAX_CANDIDATES=6
PUZZLE_MAX_SOLUTION_PLIES=11
# Require a multi-ply forced line. Set to 1 only when higher yield matters
# more than filtering out one-move tactics and mate-in-one.
PUZZLE_FALLBACK_MIN_PLIES=0

# --- Ingest (Chess.com) -----------------------------------------------------
RECENT_ARCHIVE_MONTHS=1
MAX_SYNC_GAMES=40
CHESSCOM_USER_AGENT=cccron/0.2 (contact: your-email@example.com)

# --- Opening explorer -------------------------------------------------------
# Server-side OAuth token for the authenticated Lichess Masters explorer.
LICHESS_API_KEY=your-lichess-oauth-token

# --- Delivery / Telegram ----------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_DAILY_QUOTA=1
DELIVERY_TIMEZONE=Asia/Seoul
