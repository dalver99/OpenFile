DATABASE_URL=postgresql://cccron_app:password@host:5432/cccron?sslmode=require
DB_SCHEMA=user_chess_analysis
TARGET_USER_ID=1
# Engine backend: "api" (remote HTTP Stockfish service) or "local" (local UCI binary).
STOCKFISH_MODE=api
# Used when STOCKFISH_MODE=api:
STOCKFISH_API_URL=http://127.0.0.1:8000
STOCKFISH_API_KEY=your-server-key
# Used when STOCKFISH_MODE=local:
STOCKFISH_PATH=stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128
# Analysis depth for local mode (deeper than API mode; capped at 30).
STOCKFISH_LOCAL_DEPTH=21
# Default depth for API mode; per-run override: python3 scripts/run_daily_analysis.py --depth 16
STOCKFISH_DEPTH=12
STOCKFISH_MULTIPV=3
STOCKFISH_ANALYZE_GAME_TIMEOUT_SEC=1200
HEURISTIC_VERSION=1
SERVER_SCHEMA_VERSION=1
RECENT_ARCHIVE_MONTHS=1
MAX_SYNC_GAMES=40
CHESSCOM_SYNC_FRESH_DAYS=7
ANALYSIS_RUN_STALE_MINUTES=60
CCRON_TIMEZONE=UTC
CHESSCOM_USER_AGENT=cccron/0.1 contact: your-email@example.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DAILY_SEND_HOUR=19
TELEGRAM_DAILY_SEND_MINUTE=30
TELEGRAM_DEFAULT_DAILY_QUOTA=3
PUZZLE_MIN_CP_LOSS=150
PUZZLE_MIN_TOP_SCORE_GAP_CP=120
# The best move must reach at least this eval (mover POV) or the position is too lost to teach.
PUZZLE_SOLUTION_EVAL_FLOOR_CP=-150
# If > 0, skip positions already winning by more than this (nothing to find). 0 disables.
PUZZLE_SOLUTION_EVAL_CEILING_CP=0
