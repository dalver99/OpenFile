# OpenFile normally uses the personal config created by `openfile setup`.
# You do not need to copy this file for a normal installation. These values are
# optional process-level overrides for development and portable installs; the
# Python CLI does not automatically load a repository-root `.env` file.
OPENFILE_CONFIG=
OPENFILE_CONFIG_DIR=
OPENFILE_DATA_DIR=
OPENFILE_DATABASE_PATH=
OPENFILE_LANGUAGE=en
TARGET_USER_ID=1

# Local Stockfish
STOCKFISH_PATH=
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# Analysis overrides
ANALYSIS_DEPTH=16
ANALYSIS_MULTIPV=1
ANALYSIS_DEEP_DEPTH=20
ANALYSIS_DEEP_MULTIPV=3
ANALYSIS_DEEP_THRESHOLD_CP=60
ANALYSIS_DEEP_MAX_MOVES=12

# Chess.com synchronization
RECENT_ARCHIVE_MONTHS=1
MAX_SYNC_GAMES=100
# Set an identifiable value if you redistribute or heavily automate requests.
CHESSCOM_USER_AGENT=OpenFile/0.3 (local chess review)

# Puzzle overrides
COOK_DEPTH=19
COOK_TIME_SEC=3
PUZZLE_MAX_CANDIDATES=6
PUZZLE_MAX_SOLUTION_PLIES=11
PUZZLE_FALLBACK_MIN_PLIES=0

# Optional opening-book enrichment. Prefer entering this through setup so the
# token remains in the ignored personal config directory.
LICHESS_API_KEY=
