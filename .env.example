# OpenFile normally uses the personal config created by `openfile setup`.
# Environment variables are optional process-level overrides.
OPENFILE_CONFIG=
OPENFILE_DATABASE_PATH=
OPENFILE_LANGUAGE=en
STOCKFISH_PATH=
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# Analysis overrides
ANALYSIS_DEPTH=16
ANALYSIS_MULTIPV=1
ANALYSIS_DEEP_DEPTH=20
ANALYSIS_DEEP_MULTIPV=3
ANALYSIS_DEEP_THRESHOLD_CP=60
ANALYSIS_DEEP_MAX_MOVES=12

# Puzzle overrides
COOK_DEPTH=19
COOK_TIME_SEC=3
PUZZLE_MAX_CANDIDATES=6
PUZZLE_MAX_SOLUTION_PLIES=11
PUZZLE_FALLBACK_MIN_PLIES=0

# Optional opening-book enrichment. Prefer entering this through setup so it
# remains in the ignored personal config directory.
LICHESS_API_KEY=
