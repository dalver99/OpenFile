DATABASE_URL=postgresql://cccron_app:password@host:5432/cccron?sslmode=verify-full
DB_SCHEMA=user_chess_analysis
WEBUI_USER_ID=1
WEBUI_TIMEZONE=Asia/Seoul

# Local chesspipe worker settings. These let the web UI find the same Python
# environment and STOCKFISH_PATH configured in the root .env file.
CHESSPIPE_ROOT=..
CHESSPIPE_PYTHON=.venv/bin/python
LOCAL_OPERATIONS_ENABLED=true

# Server-only OAuth token for the authenticated Lichess Masters explorer.
# Rotate any token that has been pasted into chat or another public location.
LICHESS_API_KEY=your-rotated-lichess-oauth-token
