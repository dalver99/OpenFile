# Usually no web-specific configuration is necessary: the Next.js server reads
# the same personal OpenFile config as the Python CLI.

# Developer overrides when running from an unusual checkout or Python venv.
# The defaults resolve the repository root and its venv on macOS, Linux, and
# Windows. Only set these when using a custom checkout or interpreter.
CHESSPIPE_ROOT=
CHESSPIPE_PYTHON=
LOCAL_OPERATIONS_ENABLED=true

# Optional explicit personal config path.
OPENFILE_CONFIG=

# Public base URL used in Open Graph and Twitter metadata. Change this when
# hosting OpenFile somewhere other than this local development address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
