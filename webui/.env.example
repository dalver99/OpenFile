# Usually no web-specific configuration is necessary: the Next.js server reads
# the same personal OpenFile config as the Python CLI. Copy this file to
# `.env.local` only when you need an override; `.env.local` is gitignored.

# Developer overrides when running from an unusual checkout or Python venv.
# The defaults resolve the repository root and its venv on macOS, Linux, and
# Windows. Only set these when using a custom checkout or interpreter.
CHESSPIPE_ROOT=
CHESSPIPE_PYTHON=

# Local pipeline actions are already enabled by `npm run dev`. Keep this true
# when testing a production build locally with `npm run build && npm start`.
# Do not expose that server to an untrusted network while actions are enabled.
LOCAL_OPERATIONS_ENABLED=true

# Optional personal config/database overrides. Prefer `openfile setup`.
OPENFILE_CONFIG=
OPENFILE_DATABASE_PATH=

# The application is currently single-user. Leave this at 1 unless you have
# deliberately created and configured another local user row.
WEBUI_USER_ID=1

# Optional process-level override for opening/book enrichment.
LICHESS_API_KEY=

# Public base URL used in Open Graph and Twitter metadata. Change this when
# hosting OpenFile somewhere other than this local development address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This branch is a fixed hosted showcase and always uses its demo snapshot.
OPENFILE_DEMO=true
